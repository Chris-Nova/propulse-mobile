{
  "expo": {
    "name": "Propulse",
    "slug": "propulse-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "propulse",
    "userInterfaceStyle": "automatic",
    // "splash": {
    //   "image": "./assets/splash.png",
    //   "resizeMode": "contain",
    //   "backgroundColor": "#0A0F1E"
    // },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.propulse.mobile",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:app.propulse.io"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0F1E"
      },
      "package": "com.propulse.mobile",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.propulse.io",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "propulse",
              "host": "invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Propulse needs access to your photos to upload files.",
          "cameraPermission": "Propulse needs access to your camera."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.propulse.mobile",
          "enableGooglePay": true
        }
      ],
      "expo-document-picker",
      [
        "expo-file-system",
        {}
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}